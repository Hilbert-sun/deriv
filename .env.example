# Copy to .env in the project root and fill in your provider settings.
# Use a real API credential, or an explicit placeholder accepted by a local server.
OPENAI_API_KEY=
OPENAI_MODEL=
# Leave blank to use the official SDK's default endpoint.
OPENAI_BASE_URL=

# Set BEFORE running, according to the configured provider/model's capabilities.
# json_schema = strict structured output; json_object = JSON mode;
# text = prompt-only JSON for providers without response_format support.
# First Aizex compatibility candidate; not yet verified against a live request.
OPENAI_API_MODE=responses
OPENAI_RESPONSE_FORMAT=text
# Leave false unless the selected model is known to support temperature=0.
OPENAI_TEMPERATURE_ZERO=false
OPENAI_TIMEOUT_SECONDS=180
